rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPortfolioAdmin() {
      return request.auth != null && request.auth.token.portfolio_admin == true;
    }
    match /portfolio/content {
      allow read: if isPortfolioAdmin();
      allow create, update: if isPortfolioAdmin()
        && request.resource.data.keys().hasOnly(['name','headline','about','location','experience','resumeLink'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.headline is string && request.resource.data.headline.size() <= 1000
        && request.resource.data.about is string && request.resource.data.about.size() <= 10000
        && request.resource.data.location is string && request.resource.data.location.size() <= 200
        && request.resource.data.experience is string && request.resource.data.experience.size() <= 1000
        && request.resource.data.resumeLink is string && request.resource.data.resumeLink.size() <= 2000
        && (request.resource.data.resumeLink == '' || request.resource.data.resumeLink.matches('https://[^\\s]+'));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
