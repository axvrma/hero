# Select the verified portfolio origin before production. No assumed domain.
SITE_URL=
# Optional server/build-only. Missing key uses the committed Notion snapshot.
NOTION_API_KEY=
# Configured Notion failures stop the build by default. Deliberate emergency fallback only:
NOTION_ALLOW_FALLBACK=false
# Generate a random secret of at least 32 characters. Never use VITE_ for server secrets.
API_SECRET=
# Exact HTTPS origin authorized to submit admin requests. No wildcard CORS.
ADMIN_ORIGIN=
# Server-only URL in the form https://api.netlify.com/build_hooks/<id>
NETLIFY_BUILD_HOOK=
